      "type": "SetVariable",
      "depends_on": [],
      "variable_name": "pipelineName",
      "value": {
        "value": "@pipeline().Pipeline",
        "type": "Expression"
      }
    },
    "expected": {
      "name": "set_pipeline_name",
      "task_key": "set_pipeline_name",
      "variable_name": "pipelineName",
