      "name": "fire_and_forget",
      "type": "ExecutePipeline",
      "description": "Fire and forget child pipeline",
      "depends_on": [],
      "policy": {
        "timeout": "0.01:00:00"
      },
      "pipeline": {
        "reference_name": "async_cleanup_pipeline",
        "type": "PipelineReference"
      },
