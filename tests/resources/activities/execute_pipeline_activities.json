      "parameters": null,
      "wait_on_completion": false
    }
  },
  {
    "id": "with_dependency",
    "description": "Execute Pipeline activity with upstream dependency",
    "input": {
      "name": "run_after_load",
      "type": "ExecutePipeline",
      "description": "Run child after upstream task completes",
      "depends_on": [
        {
          "activity": "load_data",
          "dependency_conditions": [
            "Succeeded"
          ]
        }
      ],
      "policy": {
        "timeout": "0.02:00:00",
        "retry": 1,
        "retry_interval_in_seconds": 60
      },
      "pipeline": {
        "reference_name": "transform_pipeline",
        "type": "PipelineReference"
      },
      "wait_on_completion": true
    },
    "expected": {
      "name": "run_after_load",
      "task_key": "run_after_load",
      "timeout_seconds": 7200,
      "max_retries": 1,
      "min_retry_interval_millis": 60000,
      "pipeline_name": "transform_pipeline",
      "depends_on": [
        {
          "task_key": "load_data",
          "outcome": null
        }
      ],
      "wait_on_completion": true
    }
  },
  {
    "id": "missing_pipeline_ref",
    "description": "Execute Pipeline activity missing pipeline reference (should return UnsupportedValue)",
    "input": {
      "name": "invalid_execute_pipeline",
      "type": "ExecutePipeline",
      "description": "Missing pipeline reference",
      "depends_on": [],
      "policy": {
        "timeout": "0.01:00:00"
      }
    },
    "expected_unsupported": true,
    "expected_message": "Missing property 'pipeline'"
  },
  {
    "id": "missing_reference_name",
    "description": "Execute Pipeline activity with pipeline ref but no reference_name",
    "input": {
      "name": "invalid_no_ref_name",
      "type": "ExecutePipeline",
      "description": "Pipeline ref without reference_name",
      "depends_on": [],
      "policy": {
        "timeout": "0.01:00:00"
      },
      "pipeline": {
        "type": "PipelineReference"
      }
    },
    "expected_unsupported": true,
    "expected_message": "Missing property 'reference_name'"
  },
