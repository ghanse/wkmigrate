[
  {
    "id": "basic",
    "description": "Basic Execute Pipeline activity with child pipeline reference",
    "input": {
      "name": "run_child_pipeline",
      "type": "ExecutePipeline",
      "description": "Invoke child pipeline",
      "depends_on": [],
      "policy": {
        "timeout": "0.01:00:00",
        "retry": 0,
        "retry_interval_in_seconds": 30
      },
      "pipeline": {
        "reference_name": "child_etl_pipeline",
        "type": "PipelineReference"
      },
      "wait_on_completion": true
    },
    "expected": {
      "name": "run_child_pipeline",
      "task_key": "run_child_pipeline",
      "description": "Invoke child pipeline",
      "timeout_seconds": 3600,
      "max_retries": 0,
      "min_retry_interval_millis": 30000,
      "pipeline_name": "child_etl_pipeline",
      "parameters": null,
      "wait_on_completion": true
    }
  },
  {
    "id": "with_parameters",
